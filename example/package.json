{
  "name": "@ant-design/react-native-example",
  "version": "5.5.0",
  "description": "Demo app for ant-design mobile RN UI Library",
  "private": true,
  "homepage": ".",
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "build-web": "EXPO_WEB_OUTPUT=static expo export -p web",
    "deploy": "npm run build-web && gh-pages -d dist --nojekyll",
    "publish": "eas update",
    "prettify": "prettier --write .  --config ./.prettierrc",
    "lint": "expo lint"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.3"
  }
}
